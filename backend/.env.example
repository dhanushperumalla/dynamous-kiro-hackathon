# AI-Sikshak Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DATABASE_URL=mongodb+srv://username:password@cluster-name.mongodb.net/
DATABASE_NAME=AI-Sikshak

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-here
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=your-email@example.com
FROM_NAME=AI-Sikshak

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_FROM_NUMBER=+1234567890

# Push Notification Configuration (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json
# OR use FIREBASE_SERVICE_ACCOUNT_KEY for JSON string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# OAuth Configuration (Google)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Security Configuration
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://default:HEs5284Cf8jasuXwUWePYGcZV0yGuo22@redis-19703.c8.us-east-1-2.ec2.cloud.redislabs.com:19703
REDIS_PASSWORD=HEs5284Cf8jasuXwUWePYGcZV0yGuo22
REDIS_DB=0

# Email Verification
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Development Configuration
ENABLE_SWAGGER=true
ENABLE_CORS=true
TRUST_PROXY=false

# Production Configuration (set these in production)
# TRUST_PROXY=true
# SECURE_COOKIES=true
# SESSION_SECRET=your-session-secret-here